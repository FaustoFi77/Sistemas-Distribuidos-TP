# Servidor
PORT=3001
NODE_ENV=development

# Base de datos SQLite (archivo local)
DATABASE_PATH=./data/iot-pets.db

# Autenticación JWT (generar un secreto aleatorio de al menos 32 bytes en producción)
JWT_SECRET=reemplazar-con-secreto-aleatorio-de-al-menos-32-bytes
JWT_EXPIRES_IN_SECONDS=86400
JWT_ISSUER=iot-pets-backend
JWT_AUDIENCE=iot-pets-web

# Rate limiting global (ventana en ms y máximo de requests por IP)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# Ovenbird IoT Cloud (credenciales de integrador del grupo — NUNCA exponer en frontend)
OVENBIRD_URL=https://iotplatform.ovenbirdconsulting.com.ar
OVENBIRD_CLIENT_ID=tu-client-id-de-ovenbird
OVENBIRD_CLIENT_SECRET=tu-client-secret-de-ovenbird

# Habilita la suscripción SSE a eventos de Ovenbird (poner false en tests o sin credenciales)
OVENBIRD_EVENTS_ENABLED=true

# Variante Grupo 3 (link-loss-zones): parámetros anti-falsas alarmas
ZONE_CONSECUTIVE_OUTSIDE_READINGS=2
ZONE_HYSTERESIS_RATIO=0.1
LINK_LOSS_GRACE_SECONDS=30
